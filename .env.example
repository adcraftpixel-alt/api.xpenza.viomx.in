DATABASE_URL=postgresql://afos_user:password@localhost:5432/aifinanceos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OPENAI_API_KEY=sk-...
GOOGLE_CLOUD_CREDENTIALS={}
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Razorpay — INR recurring auto-pay (UPI AutoPay + card e-mandate).
# Get keys from Razorpay Dashboard → Settings → API Keys.
# Webhook secret from Dashboard → Settings → Webhooks (subscribe to
# subscription.authenticated/activated/charged/pending/halted/cancelled).
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_WEBHOOK_SECRET=...
TRIAL_DAYS=30

# Shared secret the VIOMX Control Hub sends as X-Service-Key to command this
# product (block/unblock users).
SERVICE_API_KEY=

# VIOMX Control Hub — Rupexi pulls plans/caps and reports purchases here.
# CONTROL_HUB_KEY must equal RUPEXI_INGEST_KEY on the Hub.
CONTROL_HUB_URL=
CONTROL_HUB_KEY=
PRODUCT_CODE=RUPEXI
FIREBASE_SERVICE_ACCOUNT={}
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=aifinanceos-uploads
AWS_REGION=ap-south-1
SENDGRID_API_KEY=SG...
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173
ENVIRONMENT=development
# Twilio — SMS OTP delivery
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1XXXXXXXXXX
TWILIO_MESSAGING_SERVICE_SID=
